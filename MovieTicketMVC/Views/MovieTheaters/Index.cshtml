@* Define Model *@
@model IEnumerable<MovieTheater>

@* Define View Data *@
@{
    ViewData["Title"] = "List of Movie Theater";
}

@* Write Code *@
<div class="row">
    <div class="col-md-8 offset-md-2">
        <table class="table">
            <thead>
                <tr class="text-center">
                    <th>@Html.DisplayNameFor(m => m.PictureUrl)</th>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Description)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var actor in Model)
                {
                    <tr class="text-center">
                        <td class="align-middle">
                            <img class="rounded-circle" src="@actor.PictureUrl" alt="@actor.Name" style="max-width: 150px" />
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(m => actor.Name)
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(m => actor.Description)
                        </td>
                        <td class="align-middle">
                            <a class="btn btn-info"><i class="bi bi-eye"></i>Details</a>
                            <a class="btn btn-warning"><i class="bi bi-pencil-square"></i>Edit</a>
                            <a class="btn btn-danger"><i class="bi bi-trash"></i>Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tr>
                <td></td>
            </tr>
        </table>

    </div>
</div>
