@* Define Model *@
@model IEnumerable<Movie>

@* Define View Data *@
@{
    ViewData["Title"] = "List of Movies";
}

@* Write Code *@
<div class="row">
    @foreach (var movieItem in Model)
    {
        <div class="col-md-4 col-xs-6 col-md-3 border-primary mb-3">
            <div class="card mb-3" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-md-12">
                        <div class="card-header text-white bg-info">
                            <p class="card-text">
                                <h5 class="card-title">
                                    @movieItem.Title
                                    <a class="text-white float-end"><i class="bi bi-pencil-square"></i></a>
                                </h5>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img src="@movieItem.PictureUrl" width="100%" alt="@movieItem.Title">
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">
                            <p class="card-text">@movieItem.Description</p>
                            <p class="card-text"><b>Movie Theater: </b>@movieItem.MovieTheater.Name</p>
                            <p class="card-text"><b>Category: </b>@movieItem.Category</p>
                            <p class="card-text"><b>Start Date: </b>@movieItem.StartDate.ToString("ddMMMyyyy")</p>
                            <p class="card-text"><b>End Date: </b>@movieItem.EndDate.ToString("ddMMMyyyy")</p>
                            <p class="card-text">
                                <b>Status: </b>
                                @if (DateTime.Now >= movieItem.StartDate && DateTime.Now <= movieItem.EndDate)
                                {
                                    <span class="badge bg-success text-white">
                                        Available
                                    </span>
                                }
                                else if (DateTime.Now > movieItem.EndDate)
                                {
                                    <span class="badge bg-danger text-white">
                                        Unavailable
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white">
                                        Upcoming
                                    </span>
                                }
                            </p>

                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="card-footer ">
                            <p class="card-text">
                                <a class="btn btn-outline-primary float-end"><i class="bi bi-eye-fill"></i> Show Details</a>
                                <a class="btn btn-success text-white"><i class="bi bi-cart-plus"></i> Add to Cart (Price @movieItem.Price.ToString("c"))</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>