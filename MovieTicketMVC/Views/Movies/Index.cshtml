@* Define Model *@
@model IEnumerable<Movie>

@* Define View Data *@
@{
    ViewData["Title"] = "List of Movies";
}

@* Write Code *@
<div class="row justify-content-center">
    @foreach (var movieItem in Model)
    {
        <div class="col-md-4 col-6 mb-3">
            <div class="card mb-3 mx-auto" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-md-12">
                        <div class="card-header text-white bg-dark">
                            <p class="card-text">
                                <h5 class="card-title">
                                    @movieItem.Title
                                    <a class="text-white float-end"><i class="bi bi-pencil-square"></i></a>
                                </h5>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img src="@movieItem.PictureUrl" class="img-fluid" alt="@movieItem.Title" style="height:280px">
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">
                            <p class="card-text">@movieItem.Description</p>
                            <p class="card-text"><b>Category: </b>@movieItem.Category</p>
                            <p class="card-text"><b>Movie Theater: </b>@movieItem.MovieTheater.Name</p>
                            <p class="card-text"><b>Start Date: </b>@movieItem.StartDate.ToString("dd.mm.yyyy")</p>
                            <p class="card-text"><b>End Date: </b>@movieItem.EndDate.ToString("dd.mm.yyyy")</p>
                            <p class="card-text">
                                <b>Status: </b>
                                @if (DateTime.Now >= movieItem.StartDate && DateTime.Now <= movieItem.EndDate)
                                {
                                    <span class="badge bg-success text-white">
                                        Available
                                    </span>
                                }
                                else if (DateTime.Now > movieItem.EndDate)
                                {
                                    <span class="badge bg-danger text-white">
                                        Unavailable
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white">
                                        Upcoming
                                    </span>
                                }
                            </p>

                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="card-footer ">
                            <p class="card-text">
                                <a class="btn btn-outline-primary float-end"><i class="bi bi-eye-fill"></i> Show Details</a>
                                <a class="btn btn-warning text-dark"><i class="bi bi-cart-plus"></i> Add to Cart (Price @movieItem.Price.ToString("c"))</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>