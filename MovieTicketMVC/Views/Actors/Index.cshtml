@* Define Model *@
@model IEnumerable<Actor>

@* Define View Data *@
@{
    ViewData["Title"] = "List of Actors";
}

@* Write Code *@
<div class="row">
    <div class="col-md-8 offset-md-2">
        <table class="table">
            <thead>
                <tr class="text-center">
                    <th>@Html.DisplayNameFor(m => m.PictureUrl)</th>
                    <th>@Html.DisplayNameFor(m => m.FullName)</th>
                    <th>@Html.DisplayNameFor(m => m.Biography)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var actor in Model)
                {
                    <tr class="text-center">
                        <td class="align-middle">
                            <img class="rounded-circle" src="@actor.PictureUrl" alt="@actor.FullName" style="max-width: 150px"/>
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(m => actor.FullName)
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(m => actor.Biography)
                        </td>
                        <td class="align-middle">
                            <a class="btn btn-info"><i class="bi bi-eye"></i>Details</a>
                            <a class="btn btn-warning"><i class="bi bi-pencil-square"></i>Edit</a>
                            <a class="btn btn-danger"><i class="bi bi-trash"></i>Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<div class="position-sticky d-flex justify-content-end" style="bottom: 25px; margin-right: 12px; pointer-events: none; z-index: 1000;">
    <a asp-controller="Actors" asp-action="Create" class="btn btn-success d-flex align-items-center gap-2 shadow" style="pointer-events: auto;">
        <i class="bi bi-plus-circle"></i>
        Add new
    </a>
</div>
